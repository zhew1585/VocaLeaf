                                          ],
                                          "children": [
                                            {
                                              "type": "text",
                                              "id": "qgeL5",
                                              "name": "“Do not you want to know",
                                              "fill": "$ink-2",
                                              "textGrowth": "fixed-width",
                                              "width": "fill_container",
                                              "content": "“Do not you want to know who has taken it?” cried his wife impatiently.",
                                              "lineHeight": 1.5,
                                              "fontFamily": "$font-read",
                                              "fontSize": 21,
                                              "fontWeight": "normal"
                                            }
                                          ]
