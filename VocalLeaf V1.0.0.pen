                                          "padding": [
                                            7,
                                            12
                                          ],
                                          "children": [
                                            {
                                              "type": "text",
                                              "id": "wlOHE",
                                              "name": "“You want to tell me, an",
                                              "fill": "$ink",
                                              "textGrowth": "fixed-width",
                                              "width": "fill_container",
