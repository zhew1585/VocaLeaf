                                                        "bottom": 1.5
                                                      },
                                                      "children": [
                                                        {
                                                          "type": "text",
                                                          "id": "BiSUL",
                                                          "name": "It is a truth univer",
                                                          "fill": "$ink-2",
                                                          "content": "It is a truth universally acknowledged, that a single man in possession of a good",
                                                          "lineHeight": 1.2,
                                                          "fontFamily": "$font-read",
                                                          "fontSize": 21,
                                                          "fontWeight": "normal"
                                                        }
                                                      ]
                                                    },
                                                    {
                                                      "type": "frame",
                                                      "id": "KVeXz",
                                                      "name": "Line",
                                                      "stroke": "#2E5B4580",
                                                      "strokeWidth": {
                                                        "bottom": 1.5
                                                      },
                                                      "children": [
                                                        {
                                                          "type": "text",
                                                          "id": "mcfXr",
                                                          "name": "of a good fortune, m",
                                                          "fill": "$ink-2",
                                                          "content": "fortune, must be in want of a wife.",
                                                          "lineHeight": 1.2,
                                                          "fontFamily": "$font-read",
                                                          "fontSize": 21,
                                                          "fontWeight": "normal"
                                                        }
                                                      ]
                                                    }
                                                  ]
                                                }
                                              ]
                                            },
                                            {
                                              "type": "frame",
                                              "id": "JmFdz",
                                              "name": "Sentence",
                                              "width": "fill_container",
                                              "fill": "#F6F2E900",
                                              "cornerRadius": 10,
                                              "stroke": "#F6F2E900",
                                              "strokeWidth": 1.5,
                                              "padding": [
                                                7,
                                                12
                                              ],
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "CIEKE",
                                                  "name": "However little known the",
                                                  "fill": "$ink-2",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "However little known the feelings or views of such a man may be on his first entering a neighbourhood, this truth is so well fixed in the minds of the surrounding families, that he is considered as the rightful property of some one or other of their daughters.",
                                                  "lineHeight": 1.5,
                                                  "fontFamily": "$font-read",
                                                  "fontSize": 21,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "frame",
                                              "id": "C2AM8",
                                              "name": "Sentence",
                                              "width": "fill_container",
                                              "fill": "#F6F2E900",
                                              "cornerRadius": 10,
                                              "stroke": "#F6F2E900",
                                              "strokeWidth": 1.5,
                                              "padding": [
                                                7,
                                                12
                                              ],
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "ZNNlj",
                                                  "name": "“My dear Mr. Bennet,” sa",
                                                  "fill": "$ink-2",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "“My dear Mr. Bennet,” said his lady to him one day, “have you heard that Netherfield Park is let at last?”",
                                                  "lineHeight": 1.5,
                                                  "fontFamily": "$font-read",
                                                  "fontSize": 21,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "frame",
                                              "id": "tea1C",
                                              "name": "Sentence",
                                              "width": "fill_container",
                                              "fill": "#F6F2E900",
                                              "cornerRadius": 10,
                                              "stroke": "#F6F2E900",
                                              "strokeWidth": 1.5,
                                              "padding": [
                                                7,
                                                12
                                              ],
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "z3aHUj",
                                                  "name": "Mr. Bennet replied that ",
                                                  "fill": "$ink-2",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "Mr. Bennet replied that he had not.",
                                                  "lineHeight": 1.5,
                                                  "fontFamily": "$font-read",
                                                  "fontSize": 21,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "frame",
                                              "id": "L3mAo8",
