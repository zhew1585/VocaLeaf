                                            {
                                              "type": "frame",
                                              "id": "m1ygMA",
                                              "name": "Sentence",
                                              "width": "fill_container",
                                              "fill": "#F6F2E900",
                                              "cornerRadius": 10,
                                              "stroke": "#F6F2E900",
                                              "strokeWidth": 1.5,
                                              "padding": [
                                                7,
                                                12
                                              ],
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "I4W9qf",
                                                  "name": "However little known the",
                                                  "fill": "$ink-2",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "However little known the feelings or views of such a man may be on his first entering a neighbourhood, this truth is so well fixed in the minds of the surrounding families, that he is considered as the rightful property of some one or other of their daughters.",
                                                  "lineHeight": 1.5,
                                                  "fontFamily": "$font-read",
                                                  "fontSize": 21,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "frame",
                                              "id": "RmxNu",
                                              "name": "Sentence",
                                              "width": "fill_container",
                                              "fill": "#F6F2E900",
                                              "cornerRadius": 10,
                                              "stroke": "#F6F2E900",
                                              "strokeWidth": 1.5,
                                              "padding": [
                                                7,
                                                12
                                              ],
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "m9w07n",
                                                  "name": "“My dear Mr. Bennet,” sa",
                                                  "fill": "$ink-2",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "“My dear Mr. Bennet,” said his lady to him one day, “have you heard that Netherfield Park is let at last?”",
                                                  "lineHeight": 1.5,
                                                  "fontFamily": "$font-read",
                                                  "fontSize": 21,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "frame",
                                              "id": "NYGnq",
                                              "name": "Sentence",
                                              "width": "fill_container",
                                              "fill": "#F6F2E900",
                                              "cornerRadius": 10,
                                              "stroke": "#F6F2E900",
                                              "strokeWidth": 1.5,
                                              "padding": [
                                                7,
                                                12
                                              ],
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "pj8aF",
                                                  "name": "Mr. Bennet replied that ",
                                                  "fill": "$ink-2",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "Mr. Bennet replied that he had not.",
                                                  "lineHeight": 1.5,
                                                  "fontFamily": "$font-read",
                                                  "fontSize": 21,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            },
